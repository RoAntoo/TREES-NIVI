# Spring NO carga este archivo automáticamente. Exportar las variables (ver README).
AUTH_USERNAME=
# Contraseña personal de 12 a 72 bytes UTF-8.
AUTH_PASSWORD=
# Secreto aleatorio de al menos 32 bytes; no reutilizar la contraseña.
AUTH_JWT_SECRET=
AUTH_JWT_DURATION=PT2H
CORS_ALLOWED_ORIGINS=http://localhost:8100,http://localhost:4200,http://localhost,https://localhost,capacitor://localhost
DB_URL=jdbc:h2:file:./datos/nivi-lectura;DB_CLOSE_ON_EXIT=FALSE
DB_USERNAME=sa
DB_PASSWORD=
# Identificación con contacto propio, por ejemplo NIVI-Lectura (correo@tu-dominio).
OPEN_LIBRARY_USER_AGENT=
OPEN_LIBRARY_CONNECT_TIMEOUT=PT2S
OPEN_LIBRARY_READ_TIMEOUT=PT3S
OPEN_LIBRARY_BUDGET=PT10S
OPEN_LIBRARY_INTERVAL=PT1S
OPEN_LIBRARY_CACHE_ENTRIES=500
OPEN_LIBRARY_CACHE_TTL=PT15M
OPEN_LIBRARY_NEGATIVE_TTL=PT30S
PORT=8080
