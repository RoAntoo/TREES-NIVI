{
  "name": "nivi-lectura",
  "version": "0.6.4",
  "private": true,
  "type": "module",
  "description": "Biblioteca personal NIVI Lectura",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "start": "ng serve --host localhost --port 8100",
    "build": "ng build --configuration production",
    "build:desarrollo": "ng build --configuration development",
    "lint": "eslint . --max-warnings 0",
    "test": "ng test",
    "test:scripts": "node --test scripts/android.test.mjs",
    "android:preparar": "node scripts/android.mjs preparar",
    "android:build": "node scripts/android.mjs compilar",
    "android:abrir": "cap open android"
  },
  "dependencies": {
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@angular/router": "21.2.26",
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.0.1",
    "@capacitor/barcode-scanner": "3.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "8.1.5",
    "@ionic/angular": "9.0.11",
    "dompurify": "3.4.18",
    "epubjs": "0.3.93",
    "ionicons": "8.1.0",
    "jszip": "3.10.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.0"
  },
  "overrides": {
    "epubjs": {
      "@xmldom/xmldom": "0.9.12"
    }
  },
  "devDependencies": {
    "@angular/build": "21.2.30",
    "@angular/cli": "21.2.30",
    "@angular/compiler-cli": "21.2.26",
    "@capacitor/cli": "8.6.2",
    "@eslint/js": "10.0.1",
    "angular-eslint": "21.4.0",
    "eslint": "10.15.0",
    "fake-indexeddb": "6.2.8",
    "jsdom": "27.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.12"
  }
}
